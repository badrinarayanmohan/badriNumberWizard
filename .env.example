# Serply.io API
SERPLY_API_KEY=your_serply_api_key_here

# Application
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Database (for storing search history, bookmarked jobs)
# DATABASE_URL=postgresql://user:password@localhost:5432/jobsearch

# Optional: Redis (for caching)
# REDIS_URL=redis://localhost:6379

# Optional: Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
